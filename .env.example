# Runtime
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Payload CMS
PAYLOAD_SECRET=

# Database: Neon (Postgres, free tier). Production project:
#   ep-curly-dream-awgp7prw (US East) — replaced suspended ep-broad-frost-awkb8sl3
#   (quota exceeded) on 2026-09-23. Pooled URL below; code strips "-pooler"
#   (stateless HTTP driver) and normalizes sslmode to verify-full.
# Real password lives in local .env / Vercel project env — never committed.
PAYLOAD_DATABASE_ADAPTER=sqlite
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-curly-dream-awgp7prw-pooler.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_POOL_MAX=1
PAYLOAD_DB_PUSH=false

# Local fallback used by default for local testing.
DATABASE_URI=file:./dev.db

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media directory (set to /tmp on Vercel for production)
MEDIA_DIR=

# Gmail OTP sender
GMAIL_OTP_SENDER_EMAIL=
GMAIL_OTP_SENDER_APP_PASSWORD=

# Resend inquiry notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=

# Distributed/rate-limit safety
RATE_LIMIT_IP_SALT=

# Dev-only: set to "true" to log OTP codes and reset URLs to console
AUTH_DEBUG=

# Dev-only: set a code to bypass OTP verification (e.g. "123456")
OTP_DEV_BYPASS=

# Production DB SSL (set to "false" only if Neon cert causes issues)
DB_SSL_REJECT_UNAUTHORIZED=
