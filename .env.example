# Runtime
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Payload CMS
PAYLOAD_SECRET=

# Database (Postgres in production, SQLite for local fallback)
PAYLOAD_DATABASE_ADAPTER=sqlite
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
POSTGRES_POOL_MAX=1
PAYLOAD_DB_PUSH=false

# Local SQLite fallback
DATABASE_URI=file:./kerala-jewellers.db

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media directory (set to /tmp on Vercel)
MEDIA_DIR=

# Gmail (admin OTP + password-reset email)
GMAIL_OTP_SENDER_EMAIL=
GMAIL_OTP_SENDER_APP_PASSWORD=

# Resend (optional enquiry notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=

# Rate limiting
RATE_LIMIT_IP_SALT=

# Dev-only: log OTP codes / reset URLs to console
AUTH_DEBUG=

# Dev-only: fixed OTP code that skips verification (never set in production)
OTP_DEV_BYPASS=

# Production DB SSL (set to "false" only if the Postgres cert causes issues)
DB_SSL_REJECT_UNAUTHORIZED=
